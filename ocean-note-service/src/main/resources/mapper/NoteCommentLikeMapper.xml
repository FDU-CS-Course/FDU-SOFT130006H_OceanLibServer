<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oriole.ocean.dao.NoteCommentLikeDao">

    <resultMap id="noteCommentLike" type="com.oriole.ocean.common.po.mysql.NoteCommentLikeEntity">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="username" column="username" jdbcType="VARCHAR"/>
        <result property="commentId" column="comment_id" jdbcType="VARCHAR"/>
        <result property="likeTime" column="like_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- Add a like record -->
    <insert id="addNoteCommentLike" parameterType="com.oriole.ocean.common.po.mysql.NoteCommentLikeEntity">
        INSERT INTO note_comment_like (id, username, comment_id, like_time)
        VALUES (#{id}, #{username}, #{commentId}, #{likeTime})
    </insert>

    <!-- Remove a like record -->
    <delete id="removeNoteCommentLike">
        DELETE FROM note_comment_like
        WHERE username = #{username} AND comment_id = #{commentId}
    </delete>

    <!-- Find a like record -->
    <select id="findNoteCommentLike" resultMap="noteCommentLike">
        SELECT id, username, comment_id, like_time
        FROM note_comment_like
        WHERE username = #{username} AND comment_id = #{commentId}
    </select>

    <!-- Check if user has liked a note comment (returns boolean) -->
    <select id="hasUserLikedNoteComment" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM note_comment_like
        WHERE username = #{username} AND comment_id = #{commentId}
    </select>

</mapper> 